{
  "name": "saas-estoque",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm exec prisma -- generate && npm exec next -- build",
    "db:push": "npm exec prisma -- db push",
    "db:push:reset": "npm exec prisma -- db push --force-reset",
    "start": "next start",
    "generate:icons": "node scripts/generate-icons.js",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "seed": "npm exec ts-node -- --esm prisma/seed.ts",
    "postinstall": "npm exec prisma -- generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/adapter-libsql": "^7.7.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "mercadopago": "^2.12.0",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.39.0",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.19.3",
    "sharp": "^0.32.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
