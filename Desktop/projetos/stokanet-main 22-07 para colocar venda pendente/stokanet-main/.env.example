# Example environment variables for local dev + Vercel.
# Copy to .env.local (recommended) or set them in Vercel Project Settings.

# Postgres (Neon/Supabase/etc)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# MercadoPago (Subscription/Checkout)
MERCADOPAGO_ACCESS_TOKEN="APP_USR_xxxxxxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_ENV="sandbox"
DEFAULT_PAYER_EMAIL="seu-email@example.com"
MERCADOPAGO_TEST_BUYER_EMAIL="buyer_test@example.com"

# Focus NFe (NF-e)
# Docs typically: https://api.focusnfe.com.br/v2/nfe
FOCUS_NFE_BASE_URL="https://api.focusnfe.com.br"
FOCUS_NFE_TOKEN="change-me"
# Optional: override Authorization header format used by the provider.
FOCUS_NFE_AUTH_HEADER=""
# Optional: override endpoints if your provider/account uses different paths
FOCUS_NFE_ISSUE_PATH="/v2/nfe"
FOCUS_NFE_GET_PATH_TEMPLATE="/v2/nfe/{ref}"
# Optional timeouts/polling
FOCUS_NFE_TIMEOUT_MS="15000"
FOCUS_NFE_POLL_MAX_MS="8000"
# Optional default CFOP if product.cfop is empty
DEFAULT_NFE_CFOP=""

# Observação: ambiente/modelo/série/numeração são mantidos no banco em `NfeSettings`.
# Use a rota /api/nfe/settings para configurar por empresa.
